# Template. Copy to `.env.local` and fill in — real values never live here,
# because this file is committed.
#
# The app runs with none of these set: sign-in stays off, progress stays in the
# browser, /admin and the leaderboard show honest placeholders. Each capability
# switches on when its variables appear.

# Google OAuth — Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application). Register these redirect URIs there, exactly:
#   http://localhost:3000/api/auth/callback/google
#   https://<production-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Session signing key — yours, not Google's:  npx auth secret
AUTH_SECRET=

# The deployed origin, scheme and host, no trailing slash:
#   https://academy.atlys.com
#
# REQUIRED IN PRODUCTION, and the failure without it is silent rather than
# loud. Auth.js derives `trustHost` from
#   AUTH_URL ?? AUTH_TRUST_HOST ?? VERCEL ?? CF_PAGES ?? NODE_ENV !== "production"
# (@auth/core/lib/utils/env.js), so on any host that is not Vercel or
# Cloudflare Pages it lands on `false` in production. A false `trustHost` makes
# Auth.js return a non-OK session response, which every reader downstream
# treats as "not signed in": middleware bounces to /signin, the onboarding
# layout redirects, currentProfile() returns null, and every joinee falls back
# to browser-only progress that never reaches the database. `next dev` never
# shows it, because NODE_ENV flips that last default.
#
# Deploying to Vercel or Cloudflare Pages? Their own env var covers it and this
# is optional. Anywhere else, set it. AUTH_TRUST_HOST=true also works but
# trusts the incoming Host header; naming the origin here is stricter.
#
# Left COMMENTED OUT rather than blank, unlike every other key in this file,
# and that is deliberate: the chain above is `??`, which falls through on
# undefined but NOT on "". An `AUTH_URL=` copied over empty therefore reads as
# a real value of "", short-circuits the chain, and forces trustHost false even
# in development - breaking local sign-in in a way a missing line does not.
# Uncomment it with a real origin, or leave it out entirely.
# AUTH_URL=https://academy.atlys.com

# Supabase > Project Settings > API. SUPABASE_URL is the full Project URL
# (https://<ref>.supabase.co). The service-role key bypasses row-level
# security: server-side only, never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Which email domain may sign in at all. Every Google account outside it is
# rejected after the OAuth round trip, verified address or not. Defaults to
# atlys.com when unset - set it explicitly so the rule is visible here rather
# than implied by a default in the source.
AUTH_ALLOWED_DOMAIN=atlys.com

# Who can open /admin. Comma-separated. Leave this set in production: when it is
# empty the code falls back to a hardcoded address in src/lib/auth/config.ts, so
# an unset variable silently grants admin to whoever that default names.
ADMIN_EMAILS=

# Shared secret the scheduled report worker sends as the x-report-token header
# to pull the daily report. Generate with `openssl rand -hex 32` and set the
# same value here and in the worker (`wrangler secret put REPORT_TOKEN`).
# While this is empty the token path is disabled and only an admin session works.
REPORT_TOKEN=

# Slack workspace (team) id — optional. With it, mentor-card DM buttons use the
# slack:// deep link and open the desktop app; without it they fall back to
# slack.com/app_redirect, which works fine. Not a secret.
NEXT_PUBLIC_SLACK_TEAM_ID=
